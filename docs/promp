supabase
  .from('user_public_profiles')
  .select('user_id, username, avatar_url, display_name')

Outro exemplo:

ANTES:

supabase
  .from('user_profiles')
  .select('phone, address, birth_date')

DEVE SER:

supabase
  .from('user_private_profiles')
  .select('phone, address, birth_date')

